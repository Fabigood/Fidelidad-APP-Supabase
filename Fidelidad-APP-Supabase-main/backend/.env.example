# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Origenes permitidos por CORS, separados por coma. SIN barra final.
# En desarrollo: http://localhost:5173
CORS_ORIGINS=https://tudominio.com

# Numero de proxies inversos delante de la app (nginx = 1).
# Si exponés Node directo a internet, poné 0 o el limitador es evadible.
TRUST_PROXY=1

# ─── Autenticacion ───────────────────────────────────────────────────────────
# OBLIGATORIO. Generalo con: openssl rand -base64 48
# NUNCA reutilices este valor de ejemplo.
JWT_SECRET=CAMBIAME_generar_con_openssl_rand_base64_48
JWT_EXPIRES_IN=8h

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave de servicio: el backend la necesita para operar con RLS activo.
# Es SECRETA, jamas debe aparecer en el frontend ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Solo como respaldo para desarrollo local sin RLS. En produccion usá la de arriba.
SUPABASE_ANON_KEY=

# ─── Correo (Brevo) ──────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Fidelidad APP

# Poner en true SOLO en local para ver el detalle interno de los errores 500.
EXPOSE_ERROR_DETAILS=false

# Zona horaria del negocio. El VPS suele estar en UTC: definila para que los
# calculos de fidelidad usen el dia real del local. Ej: America/Guayaquil
APP_TIMEZONE=UTC
